# name: test/sql/ggsql_visualise_spelling.test
# description: VISUALISE is accepted as a spelling of VISUALIZE (#84); upstream ggsql accepts both
# group: [stats_duck]

require stats_duck

statement ok
CREATE TABLE penguins AS
SELECT * FROM (VALUES (39.1, 18.7), (39.5, 17.4), (40.3, 18.0)) AS t(bill_len, bill_dep);

# The two spellings give the same spec and the same layer SQL.
query TT
VISUALISE bill_len AS x, bill_dep AS y FROM penguins DRAW point
----
{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","data":{"name":"layer_0"},"mark":"point","encoding":{"x":{"field":"x","type":"quantitative"},"y":{"field":"y","type":"quantitative"}}}	{layer_0='SELECT bill_len AS x, bill_dep AS y FROM penguins'}

query TT
VISUALIZE bill_len AS x, bill_dep AS y FROM penguins DRAW point
----
{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","data":{"name":"layer_0"},"mark":"point","encoding":{"x":{"field":"x","type":"quantitative"},"y":{"field":"y","type":"quantitative"}}}	{layer_0='SELECT bill_len AS x, bill_dep AS y FROM penguins'}

# Lowercase, like the other keywords.
query TT
visualise bill_len as x, bill_dep as y from penguins draw point
----
{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","data":{"name":"layer_0"},"mark":"point","encoding":{"x":{"field":"x","type":"quantitative"},"y":{"field":"y","type":"quantitative"}}}	{layer_0='SELECT bill_len AS x, bill_dep AS y FROM penguins'}

# The WITH form is claimed by the keyword scan as well.
query TT
WITH big AS (SELECT * FROM penguins WHERE bill_len > 39.2)
VISUALISE bill_len AS x, bill_dep AS y FROM big DRAW point
----
{"$schema":"https://vega.github.io/schema/vega-lite/v5.json","data":{"name":"layer_0"},"mark":"point","encoding":{"x":{"field":"x","type":"quantitative"},"y":{"field":"y","type":"quantitative"}}}	{layer_0='WITH big AS (SELECT * FROM penguins WHERE bill_len > 39.2) SELECT bill_len AS x, bill_dep AS y FROM big'}

# An error inside the statement comes from our parser, not from DuckDB's
# syntax error at the first keyword.
statement error
VISUALISE bill_len AS x, bill_dep AS y FROM penguins DRAW nope
----
unknown mark 'nope'

# The word inside a string literal does not make a statement ours
# (upstream's own guard).
query I
SELECT 'I love VISUALISE' AS s
----
I love VISUALISE
