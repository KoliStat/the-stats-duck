# get_started/first_plot.qmd: waits for SCALE ... RENAMING (Tier 3) and LABEL (1b)
statement error
VISUALISE bill_len AS x, bill_dep AS y, species AS fill FROM penguins
DRAW point
SCALE x
  RENAMING * => '{} mm'
LABEL
  title => 'Relationship between bill dimensions in 3 species of penguins',
  x => 'Bill length',
  y => 'Bill depth'
----
Unknown SCALE operator 'RENAMING'

# get_started/anatomy.qmd: waits for per-layer MAPPING and SETTING (not
# scheduled), the smooth alias (1a), SCALE BINNED with SETTING breaks (1a, partly)
statement error
VISUALISE bill_len AS x, bill_dep AS y, species AS stroke FROM penguins
DRAW point
  MAPPING body_mass AS size
  SETTING fill => null
DRAW smooth
  SETTING method => 'ols'
SCALE stroke TO dark2
SCALE BINNED size TO (4, 15)
  SETTING breaks => 4
----
Expected 'DRAW', got 'MAPPING'

