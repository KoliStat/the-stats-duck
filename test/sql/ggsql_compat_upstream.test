# name: test/sql/ggsql_compat_upstream.test
# description: The example statements of the ggsql.org pages, run as upstream wrote them (block 1a of the 0.10 plan, #58)
# group: [stats_duck]

require stats_duck

# Every statement in this file is copied from a page of ggsql.org. The sources
# are the qmd files under doc/ in posit-dev/ggsql, read 2026-10-30 at ggsql
# 0.5.2. One substitution is made: the bundled data sources `ggsql:penguins`
# and `ggsql:airquality` become the tables of the same name and columns that
# are created below. One blank line inside a heatmap statement is removed,
# because the test format ends a statement at a blank line.
#
# A statement counts as passing when it parses and produces a spec. It is then
# a `statement ok` block. Whether the spec means what upstream's chart means
# is the job of the feature tests, and of #39 for the channel types. A
# statement that does not run yet is a `statement error` block, with the #58
# item it waits for in the comment above it. This file therefore fails the
# day a feature makes a pending statement pass, and the block is moved up.
# Our own parser messages are pinned. DuckDB's syntax errors are pinned to the
# error type only (`Parser Error`), because the token they name differs
# between the 1.x and 2.0 parsers.
#
# Three statements are accepted today but lose their `colour` channel without
# an error. They are listed as comments at the end and do not count.
#
# Passing: 7 of 55 statements. Count the `statement ok` blocks after the two
# CREATE TABLE statements.

statement ok
CREATE TABLE penguins AS
SELECT * FROM (VALUES
    ('Adelie',    'Torgersen', 39.1, 18.7, 181, 3750, 'male',   2007),
    ('Adelie',    'Biscoe',    39.5, 17.4, 186, 3800, 'female', 2007),
    ('Gentoo',    'Biscoe',    46.1, 13.2, 211, 4500, 'female', 2008),
    ('Gentoo',    'Biscoe',    50.0, 16.3, 230, 5700, 'male',   2008),
    ('Chinstrap', 'Dream',     46.5, 17.9, 192, 3500, 'female', 2009),
    ('Chinstrap', 'Dream',     50.0, 19.5, 196, 3900, 'male',   2009)
) AS t(species, island, bill_len, bill_dep, flipper_len, body_mass, sex, year);

statement ok
CREATE TABLE airquality AS
SELECT * FROM (VALUES
    (41,   190, 7.4,  67, 5, 1, DATE '1973-05-01'),
    (36,   118, 8.0,  72, 5, 2, DATE '1973-05-02'),
    (NULL, 149, 12.6, 74, 5, 3, DATE '1973-05-03'),
    (23,   299, 8.6,  65, 6, 1, DATE '1973-06-01'),
    (45,   252, 14.9, 81, 6, 2, DATE '1973-06-02'),
    (115,  223, 5.7,  79, 6, 3, DATE '1973-06-03')
) AS t(Ozone, Solar_R, Wind, Temp, Month, Day, Date);

# ===========================================================================
# Passing
# ===========================================================================

# gallery/examples/boxplot.qmd, first example
statement ok
VISUALISE species AS x, bill_len AS y FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, fill by a second column
statement ok
VISUALISE species AS x, bill_len AS y, island AS fill FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, fill by the x column
statement ok
VISUALISE species AS x, bill_len AS y, species AS fill FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, horizontal
statement ok
VISUALISE bill_len AS x, species AS y, island AS fill FROM penguins
  DRAW boxplot

# get_started/anatomy.qmd, the histogram
statement ok
VISUALISE body_mass AS x FROM penguins
DRAW histogram

# gallery/examples/violin.qmd, first example
statement ok
VISUALISE species AS x, bill_len AS y FROM penguins
  DRAW violin

# gallery/examples/violin.qmd, horizontal
statement ok
VISUALISE bill_len AS x, species AS y FROM penguins
  DRAW violin

