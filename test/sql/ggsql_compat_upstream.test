# name: test/sql/ggsql_compat_upstream.test
# description: Upstream ggsql examples that run unchanged here (block 1a of the 0.10 plan, #58)
# group: [stats_duck]

require stats_duck

# Every statement in this file is copied from a page of ggsql.org (the qmd
# sources under doc/ in posit-dev/ggsql, read 2026-10-30 at ggsql 0.5.2), with
# one substitution: the bundled data sources `ggsql:penguins` and
# `ggsql:airquality` are replaced by tables of the same name and columns,
# created below. The syntax is otherwise verbatim.
#
# Passing statements: 7. The statements that do not run yet are listed at the
# end of the file with the #58 item each one waits for; they move up here as
# the items land. The number of passing statements is the progress measure of
# block 1a.

statement ok
CREATE TABLE penguins AS
SELECT * FROM (VALUES
    ('Adelie',    'Torgersen', 39.1, 18.7, 181, 3750, 'male',   2007),
    ('Adelie',    'Biscoe',    39.5, 17.4, 186, 3800, 'female', 2007),
    ('Gentoo',    'Biscoe',    46.1, 13.2, 211, 4500, 'female', 2008),
    ('Gentoo',    'Biscoe',    50.0, 16.3, 230, 5700, 'male',   2008),
    ('Chinstrap', 'Dream',     46.5, 17.9, 192, 3500, 'female', 2009),
    ('Chinstrap', 'Dream',     50.0, 19.5, 196, 3900, 'male',   2009)
) AS t(species, island, bill_len, bill_dep, flipper_len, body_mass, sex, year);

# gallery/examples/boxplot.qmd, first example
statement ok
VISUALISE species AS x, bill_len AS y FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, fill by a second column
statement ok
VISUALISE species AS x, bill_len AS y, island AS fill FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, fill by the x column
statement ok
VISUALISE species AS x, bill_len AS y, species AS fill FROM penguins
  DRAW boxplot

# gallery/examples/boxplot.qmd, horizontal
statement ok
VISUALISE bill_len AS x, species AS y, island AS fill FROM penguins
  DRAW boxplot

# get_started/anatomy.qmd, the histogram
statement ok
VISUALISE body_mass AS x FROM penguins
DRAW histogram

# gallery/examples/violin.qmd, first example
statement ok
VISUALISE species AS x, bill_len AS y FROM penguins
  DRAW violin

# gallery/examples/violin.qmd, horizontal
statement ok
VISUALISE bill_len AS x, species AS y FROM penguins
  DRAW violin

