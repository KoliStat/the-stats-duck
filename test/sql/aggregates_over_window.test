# name: test/sql/aggregates_over_window.test
# description: Every aggregate works as a window function: OVER () equals the plain aggregate and OVER (PARTITION BY) equals GROUP BY (#69)
# group: [stats_duck]

require stats_duck

# DuckDB's constant-frame window path (OVER () and OVER (PARTITION BY ...)
# without ORDER BY or a frame) calls an aggregate's update once per partition
# with a CONSTANT state vector: one state pointer for every input row. Until
# #69 every update function in this extension read that vector as FLAT,
# indexed it by row, and crashed the process. A framed window (ROWS BETWEEN)
# goes through the segment tree with a flat vector and always worked. Each
# block compares the window result with the plain aggregate, struct by struct;
# IS NOT DISTINCT FROM treats NULL fields as equal.

statement ok
CREATE TABLE t AS
SELECT i::DOUBLE AS y,
       (i * 2 + i % 3)::DOUBLE AS x1,
       (i % 3)::VARCHAR AS g,
       (i + i % 4)::DOUBLE AS a,
       (i * 1.5 + 1)::DOUBLE AS b,
       CASE WHEN i % 5 < 2 THEN 'p' WHEN i % 5 < 4 THEN 'q' ELSE 'r' END AS k
FROM range(1, 31) AS r(i);

# ─── OVER (): the whole table as one partition ───────────────────────────────

query T
SELECT bool_and(w IS NOT DISTINCT FROM (SELECT ttest_1samp(y, 0.0) FROM t))
FROM (SELECT ttest_1samp(y, 0.0) OVER () AS w FROM t);
----
true

query T
SELECT bool_and(w IS NOT DISTINCT FROM (SELECT ttest_paired(a, b) FROM t))
FROM (SELECT ttest_paired(a, b) OVER () AS w FROM t);
----
true

query T
SELECT bool_and(w IS NOT DISTINCT FROM (SELECT ttest_2samp(a, b) FROM t))
