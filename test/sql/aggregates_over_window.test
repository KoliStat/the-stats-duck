# bootstrap draws its resamples from the rows in the order they arrive, so only
# the fact that it runs under a window is pinned here.
statement ok
SELECT bootstrap(y, 'mean', 50, 7) OVER () FROM t;

# ─── OVER (PARTITION BY ...): several states behind one constant vector ──────

query T
SELECT bool_and(w IS NOT DISTINCT FROM gr)
FROM (SELECT g, ttest_1samp(y, 0.0) OVER (PARTITION BY g) AS w FROM t) AS win
JOIN (SELECT g, ttest_1samp(y, 0.0) AS gr FROM t GROUP BY g) AS grp USING (g);
----
true

query T
SELECT bool_and(w IS NOT DISTINCT FROM gr)
FROM (SELECT k, anova_oneway(y, g) OVER (PARTITION BY k) AS w FROM t) AS win
JOIN (SELECT k, anova_oneway(y, g) AS gr FROM t GROUP BY k) AS grp USING (k);
----
true

query T
SELECT bool_and(w IS NOT DISTINCT FROM gr)
FROM (SELECT g, lm_fit(y, [x1]) OVER (PARTITION BY g) AS w FROM t) AS win
JOIN (SELECT g, lm_fit(y, [x1]) AS gr FROM t GROUP BY g) AS grp USING (g);
----
true

# ─── A framed window takes the segment-tree path, which always worked ────────

# The frame up to y = 20 holds the same rows, in the same order, as the plain
# aggregate over y <= 20.
query T
SELECT w IS NOT DISTINCT FROM (SELECT lm_fit(y, [x1]) FROM t WHERE y <= 20)
FROM (SELECT y, lm_fit(y, [x1]) OVER (ORDER BY y ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS w FROM t)
WHERE y = 20;
----
true
