# name: test/sql/distribution_nan_args.test
# description: A NaN argument to a distribution function gives NULL (#102)
# group: [stats_duck]

require stats_duck

# Every overload of every density, distribution and quantile function. The
# first column calls it with valid arguments, which must give a value. Each
# other column puts NaN into one DOUBLE argument, which must give NULL.
# Weibull takes x equal to the scale, because pow(1, NaN) is 1.

query TTTT
SELECT dbeta(0.3, 2.0, 3.0) IS NOT NULL,
       dbeta('nan'::DOUBLE, 2.0, 3.0) IS NULL,
       dbeta(0.3, 'nan'::DOUBLE, 3.0) IS NULL,
       dbeta(0.3, 2.0, 'nan'::DOUBLE) IS NULL
----
true	true	true	true

query TTT
SELECT dchisq(2.0, 3.0) IS NOT NULL,
       dchisq('nan'::DOUBLE, 3.0) IS NULL,
       dchisq(2.0, 'nan'::DOUBLE) IS NULL
----
true	true	true

query TT
SELECT dexp(1.0) IS NOT NULL,
       dexp('nan'::DOUBLE) IS NULL
----
true	true

query TTT
SELECT dexp(1.0, 2.0) IS NOT NULL,
       dexp('nan'::DOUBLE, 2.0) IS NULL,
       dexp(1.0, 'nan'::DOUBLE) IS NULL
----
true	true	true

